# Backend Environment Variables
# Copy this file to local.settings.json and fill in your values

{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    
    "# Azure OpenAI Configuration": "",
    "AZURE_OPENAI_ENDPOINT": "https://your-resource.openai.azure.com/",
    "AZURE_OPENAI_KEY": "your-api-key-here",
    "AZURE_OPENAI_DEPLOYMENT": "stude-gpt4omini",
    "AZURE_OPENAI_WHISPER_DEPLOYMENT": "whisper",

    "# Clerk Authentication (required for production):": "",
    "# Verifies Bearer session tokens on every AI endpoint. If not set,": "",
    "# authentication is DISABLED (dev mode). Use the same CLERK_SECRET_KEY": "",
    "# as the frontend .env.local.",
    "CLERK_SECRET_KEY": "sk_test_your_secret_key",
    
    "# Azure Storage Configuration": "",
    "AZURE_STORAGE_CONNECTION_STRING": "UseDevelopmentStorage=true",
    
    "# CORS Configuration": "",
    "ALLOWED_ORIGIN": "*"
  }
}
