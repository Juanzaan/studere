# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL
# For local development: http://localhost:7071
# For production: https://your-backend.azurewebsites.net
NEXT_PUBLIC_BACKEND_URL=http://localhost:7071

# Clerk authentication (see https://clerk.com)
# Replace with YOUR values from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Clerk routing (can stay at these defaults)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
