# Studere — Variables de entorno
# Copiá este archivo a .env.local y completá los valores

# ─── REQUERIDO ────────────────────────────────────────────
# URL del backend Azure Functions
# Local:
NEXT_PUBLIC_BACKEND_URL=http://localhost:7071
# Staging:  NEXT_PUBLIC_BACKEND_URL=https://studere-backend-staging.azurewebsites.net
# Producción: NEXT_PUBLIC_BACKEND_URL=https://studere-backend.azurewebsites.net

# ─── Clerk (autenticación) ────────────────────────────────
# Obtené tus claves en https://dashboard.clerk.com
# ⚠️ NUNCA commitees CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_TU_CLAVE_PUBLICABLE
CLERK_SECRET_KEY=sk_test_TU_CLAVE_SECRETA
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Solo E2E (Playwright) ────────────────────────────────
# Usuario de prueba en Clerk con email terminado en +clerk_test
# (ej: e2e+clerk_test@example.com) para que no se envíe el mail
E2E_CLERK_USER_EMAIL=tu-email+clerk_test@example.com

# ─── OPCIONAL — Analytics ─────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ─── OPCIONAL — Feature flags ─────────────────────────────
# NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
# NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
